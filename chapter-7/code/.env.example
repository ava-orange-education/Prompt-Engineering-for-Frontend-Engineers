# NovaMart dashboard runs entirely on synthetic, client-generated data —
# no environment variables are required for local development or build.
#
# The following are only needed if you wire up CI/CD deployment to Vercel
# (see .github/workflows/ci.yml). Set these as GitHub Actions secrets,
# not in a committed .env file:
#
#   VERCEL_TOKEN=
#   VERCEL_ORG_ID=
#   VERCEL_PROJECT_ID=
